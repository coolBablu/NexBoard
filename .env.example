# ═══════════════════════════════════════════════════════════════════════
#  NovaFlow — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#  Local dev: copy this file to `.env.local`
#  Vercel:    paste each variable into Project Settings → Environment
#             Variables (Production + Preview)
#  See DEPLOYMENT.md for the full Vercel walkthrough.
# ═══════════════════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────────────────────┐
# │  ① Runtime mode                                                     │
# └─────────────────────────────────────────────────────────────────────┘
#
# DEMO_MODE=true   → spins up an in-memory MongoDB, auto-seeds demo data,
#                    works zero-config. Great for local dev + preview
#                    deployments + investor demos.
#
# DEMO_MODE=false  → uses MONGODB_URI below. REQUIRED for production.
#
DEMO_MODE=true


# ┌─────────────────────────────────────────────────────────────────────┐
# │  ② MongoDB (only when DEMO_MODE=false)                              │
# └─────────────────────────────────────────────────────────────────────┘
#
# MongoDB Atlas connection string. Create a free cluster at
#   https://www.mongodb.com/cloud/atlas
#
# IMPORTANT — Atlas Network Access:
#   For Vercel, add 0.0.0.0/0 to your IP allow list (or wire up a
#   PrivateLink for production). Vercel functions have ephemeral IPs.
#
# IMPORTANT — Atlas Database User:
#   Create a database user with "Read and write to any database".
#   URL-encode any special characters in the password.
#
# Example (Atlas):
#   mongodb+srv://novaflow:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=NovaFlow
#
# MONGODB_URI=
MONGODB_DB=novaflow


# ┌─────────────────────────────────────────────────────────────────────┐
# │  ③ NextAuth (Auth.js v5)                                            │
# └─────────────────────────────────────────────────────────────────────┘
#
# Generate a strong secret (32-byte base64):
#   openssl rand -base64 32
#   # or, on Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#
# Use the same value for `AUTH_SECRET` if you ever rename — Auth.js v5
# reads either.
NEXTAUTH_SECRET=replace-me-with-32-byte-random-string

# The public URL of your deployment. Auth.js needs this for OAuth
# callbacks and cookie domain inference.
#   Local:   http://localhost:3000
#   Vercel:  https://your-domain.com  (or https://<project>.vercel.app)
#
# On Vercel: SKIP this — Vercel auto-injects $VERCEL_URL and Auth.js v5
# picks it up when AUTH_TRUST_HOST=true.
NEXTAUTH_URL=http://localhost:3000

# REQUIRED on Vercel / behind any reverse proxy so Auth.js trusts the
# X-Forwarded-Host header. Safe to leave true in dev.
AUTH_TRUST_HOST=true


# ┌─────────────────────────────────────────────────────────────────────┐
# │  ④ OAuth providers (optional)                                       │
# └─────────────────────────────────────────────────────────────────────┘
#
# Each provider is only registered when BOTH the ID and the SECRET are
# set. Buttons stay visible either way — disabled ones surface a hint.
#
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI:
#     dev:  http://localhost:3000/api/auth/callback/google
#     prod: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub: https://github.com/settings/developers (New OAuth App)
#   Authorization callback URL:
#     dev:  http://localhost:3000/api/auth/callback/github
#     prod: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=


# ┌─────────────────────────────────────────────────────────────────────┐
# │  ⑤ AI (optional)                                                    │
# └─────────────────────────────────────────────────────────────────────┘
#
# Provider auto-selection (first match wins):
#   · OPENROUTER_API_KEY → OpenRouter gateway (hundreds of models incl.
#                          several FREE tiers — best for demos & hobby).
#   · OPENAI_API_KEY     → OpenAI direct.
#   · neither set        → streamed mock reply so the UI pipeline
#                          (stream, markdown, AIHistory log) still works.
#
# ── OpenRouter (recommended for demos) ────────────────────────────────
# Get a key:  https://openrouter.ai/keys
# Free models (no credit needed):
#   meta-llama/llama-3.3-70b-instruct:free
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemma-2-9b-it:free
#   x-ai/grok-4-fast:free
# Paid (pennies):  openai/gpt-4o-mini, anthropic/claude-3.5-haiku, …
#
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# ── OpenAI direct ─────────────────────────────────────────────────────
# Get a key:   https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini


# ┌─────────────────────────────────────────────────────────────────────┐
# │  ⑥ App URL (for SEO + sitemap + OAuth)                              │
# └─────────────────────────────────────────────────────────────────────┘
#
# The canonical, publicly-reachable URL of your deployment. Used by:
#   · sitemap.xml + robots.txt
#   · Open Graph image absolute URLs
#   · The "View" button in toast notifications
#
# Local:  http://localhost:3000
# Prod:   https://novaflow.app  (your real domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
